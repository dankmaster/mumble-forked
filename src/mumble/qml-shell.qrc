	<file alias="ModernMenu.qml">qml-shell/ModernMenu.qml</file>
	<file alias="NavigationRail.qml">qml-shell/NavigationRail.qml</file>
	<file alias="PayloadMenuItem.qml">qml-shell/PayloadMenuItem.qml</file>
	<file alias="ConnectionBanner.qml">qml-shell/ConnectionBanner.qml</file>
	<file alias="MotdPanel.qml">qml-shell/MotdPanel.qml</file>
	<file alias="UpdateBanner.qml">qml-shell/UpdateBanner.qml</file>
	<file alias="ScreenShareEditor.qml">qml-shell/ScreenShareEditor.qml</file>
	<file alias="ImageViewer.qml">qml-shell/ImageViewer.qml</file>
	<file alias="StonksEditor.qml">qml-shell/StonksEditor.qml</file>
	<file alias="ScreenShareViewWindow.qml">qml-shell/ScreenShareViewWindow.qml</file>
    <file alias="PttTool.qml">qml-shell/PttTool.qml</file>
    <file alias="QmlDialog.qml">qml-shell/QmlDialog.qml</file>
    <file alias="PluginEditor.qml">qml-shell/PluginEditor.qml</file>
    <file alias="MessageEventEditor.qml">qml-shell/MessageEventEditor.qml</file>
    <file alias="ShortcutEditor.qml">qml-shell/ShortcutEditor.qml</file>
    <file alias="AclEditor.qml">qml-shell/AclEditor.qml</file>
    <file alias="MediaSessionWindow.qml">qml-shell/MediaSessionWindow.qml</file>
