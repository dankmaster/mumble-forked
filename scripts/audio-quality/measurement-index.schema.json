{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mumble.info/schemas/input-enhancement-measurement-index-v1.json",
  "title": "Input enhancement measurement index",
  "description": "Canonical audio-free index binding qualification cases to exact benchmark, E2E, fixed-timeline, objective-score, transition, and soak reports. Semantic validation is implemented by measurement_evidence.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build",
    "cases",
    "kind",
    "metrics_runtime_attestation",
    "objective_runtime_binding_sha256",
    "plan_binding",
    "profile_bindings",
    "published_artifacts",
    "qualification_binding_sha256",
    "qualification_scope",
    "release_holdout_approval_public_key_sha256",
    "release_holdout_openings",
    "schema_version",
    "soak_reports",
    "suite",
    "transitions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "mumble-input-enhancement-measurement-index-v1" },
    "qualification_scope": { "enum": ["core", "auto"] },
    "suite": { "enum": ["pr_smoke", "master_quality", "nightly", "release"] },
    "qualification_binding_sha256": { "$ref": "#/$defs/sha256" },
    "objective_runtime_binding_sha256": { "$ref": "#/$defs/sha256" },
    "release_holdout_approval_public_key_sha256": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "metrics_runtime_attestation": { "$ref": "#/$defs/reference" },
    "build": { "type": "object" },
    "plan_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_set_sha256", "corpus_inventory_sha256", "corpus_lock_sha256", "mixture_plan_sha256"],
      "properties": {
        "case_set_sha256": { "$ref": "#/$defs/sha256" },
        "corpus_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "corpus_lock_sha256": { "$ref": "#/$defs/sha256" },
        "mixture_plan_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "profile_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profileBinding" }
    },
    "published_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact", "name"],
        "properties": {
          "artifact": { "$ref": "#/$defs/reference" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "release_holdout_openings": {
      "type": "array",
      "items": { "$ref": "#/$defs/releaseHoldoutOpening" }
    },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
    "soak_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "report"],
        "properties": {
          "profile": { "$ref": "#/$defs/profile" },
          "report": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "directed_pair", "report"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "directed_pair": { "type": "string", "minLength": 1 },
          "report": { "$ref": "#/$defs/reference" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "suite": { "const": "release" } }, "required": ["suite"] },
      "then": {
        "properties": {
          "release_holdout_approval_public_key_sha256": { "$ref": "#/$defs/sha256" },
          "release_holdout_openings": { "minItems": 1 }
        }
      },
      "else": {
        "properties": {
          "release_holdout_approval_public_key_sha256": { "type": "null" },
          "release_holdout_openings": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "profile": { "enum": ["Original", "Light", "Balanced", "Quality", "VoiceFocus", "Auto"] },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_audio_samples", "path", "sha256", "size_bytes"],
      "properties": {
        "contains_audio_samples": { "const": false },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "profileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "models", "profile", "recipe"],
      "properties": {
        "profile": { "$ref": "#/$defs/profile" },
        "engine": { "enum": ["None", "Speex", "RNNoise", "DeepFilterNet"] },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["catalog_revision", "id", "manifest_sha256", "revision"],
          "properties": {
            "catalog_revision": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "manifest_sha256": { "$ref": "#/$defs/sha256" },
            "revision": { "type": "integer", "minimum": 1 }
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sha256", "version"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "releaseHoldoutOpening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_public_key",
        "attestation",
        "case_id",
        "detached_signature",
        "opening_report",
        "profile",
        "receipt",
        "run_id"
      ],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/profile" },
        "run_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
        "attestation": { "$ref": "#/$defs/reference" },
        "detached_signature": { "$ref": "#/$defs/reference" },
        "approval_public_key": { "$ref": "#/$defs/reference" },
        "receipt": { "$ref": "#/$defs/reference" },
        "opening_report": { "$ref": "#/$defs/reference" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "clean_reference_sha256",
        "condition",
        "dataset_split",
        "measurement_mode",
        "plan_case_sha256",
        "profile",
        "render_entry_sha256",
        "reports",
        "source_input_sha256"
      ],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "profile": { "$ref": "#/$defs/profile" },
        "condition": { "enum": ["clean", "noisy", "severe"] },
        "dataset_split": { "type": "string", "minLength": 1 },
        "measurement_mode": { "enum": ["offline", "e2e"] },
        "plan_case_sha256": { "$ref": "#/$defs/sha256" },
        "render_entry_sha256": { "$ref": "#/$defs/sha256" },
        "source_input_sha256": { "$ref": "#/$defs/sha256" },
        "clean_reference_sha256": { "$ref": "#/$defs/sha256" },
        "reports": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/reference" }
        }
      }
    }
  }
}
