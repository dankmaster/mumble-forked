{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mumble.info/schemas/input-enhancement-soak-report-v2.json",
  "title": "Input enhancement realtime soak report",
  "description": "Audio-free evidence from a monotonic realtime product-pipeline soak. Cross-field wall/audio, RSS, binding, and build-identity checks are enforced by measurement_evidence.py and the producer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "active_bindings",
    "audio_duration_seconds",
    "callback_p99_ms",
    "deadline_miss_count",
    "declared_latency_samples",
    "execution_identity",
    "fallback_count",
    "invalid_output_count",
    "kind",
    "maximum_internal_processing_ms",
    "mean_rtf",
    "memory_growth_bytes_after_warmup",
    "new_clipping_count",
    "profile",
    "rss_end_bytes",
    "rss_peak_bytes",
    "rss_warmup_bytes",
    "schema_version",
    "status",
    "tail_drain_failure_count",
    "wall_duration_seconds",
    "worker_p99_ms"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "mumble-input-enhancement-soak-v2" },
    "status": { "const": "completed" },
    "profile": { "enum": ["Balanced", "Quality", "VoiceFocus", "Auto"] },
    "active_bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profileBinding" }
    },
    "execution_identity": { "$ref": "#/$defs/executionIdentity" },
    "audio_duration_seconds": { "type": "number", "minimum": 1 },
    "wall_duration_seconds": { "type": "number", "minimum": 1 },
    "declared_latency_samples": { "type": "integer", "minimum": 0 },
    "mean_rtf": { "type": "number", "minimum": 0 },
    "callback_p99_ms": { "type": "number", "minimum": 0 },
    "worker_p99_ms": { "type": "number", "minimum": 0 },
    "maximum_internal_processing_ms": { "type": "number", "minimum": 0 },
    "memory_growth_bytes_after_warmup": { "type": "integer" },
    "rss_warmup_bytes": { "type": "integer", "minimum": 0 },
    "rss_end_bytes": { "type": "integer", "minimum": 0 },
    "rss_peak_bytes": { "type": "integer", "minimum": 0 },
    "deadline_miss_count": { "type": "integer", "minimum": 0 },
    "fallback_count": { "type": "integer", "minimum": 0 },
    "invalid_output_count": { "type": "integer", "minimum": 0 },
    "new_clipping_count": { "type": "integer", "minimum": 0 },
    "tail_drain_failure_count": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "executionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_binary_sha256",
        "model_manifest_sha256",
        "recipe_manifest_sha256",
        "run_provenance_sha256",
        "runtime_payload_sha256",
        "server_binary_sha256"
      ],
      "properties": {
        "client_binary_sha256": { "$ref": "#/$defs/sha256" },
        "model_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "recipe_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "run_provenance_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_payload_sha256": { "$ref": "#/$defs/sha256" },
        "server_binary_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "profileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "models", "profile", "recipe"],
      "properties": {
        "profile": { "enum": ["Light", "Balanced", "Quality", "VoiceFocus", "Auto"] },
        "engine": { "enum": ["Speex", "RNNoise", "DeepFilterNet"] },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["catalog_revision", "id", "manifest_sha256", "revision"],
          "properties": {
            "catalog_revision": { "type": "string", "minLength": 1 },
            "id": { "type": "string", "minLength": 1 },
            "manifest_sha256": { "$ref": "#/$defs/sha256" },
            "revision": { "type": "integer", "minimum": 1 }
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sha256", "version"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
